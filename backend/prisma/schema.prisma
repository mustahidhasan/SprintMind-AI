generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Issue {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}
